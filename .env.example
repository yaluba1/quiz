# ==============================================================================
# Quiz Platform Environment Configuration (Example)
# Copy this file to .env before deploying
# ==============================================================================

# Domain Configuration (Single Domain Path-Based Setup)
# Base URL: https://${DOMAIN}/ (Landing page & PIN game join)
# Teacher Dashboard: https://${DOMAIN}/teacher
# API & WebSockets: https://${DOMAIN}/api and https://${DOMAIN}/socket.io
DOMAIN=quiz.example.com

# Optional Subdomain Override (if a separate API subdomain is desired, e.g. api.quiz.example.com or api.localhost)
# In single-domain mode, do NOT set API_SUBDOMAIN to the same value as DOMAIN or localhost.
API_SUBDOMAIN=api.quiz.example.com

# Let's Encrypt / ACME TLS Configuration
ACME_EMAIL=admin@example.com

# Node Environment
NODE_ENV=production

# Database Configuration
POSTGRES_DB=quiz_db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Traefik Dashboard (set to true only for debugging/internal network)
TRAEFIK_DASHBOARD_ENABLED=false

# S3 / Garage Multimedia Storage Configuration (Ultra-low footprint ~25MB RAM)
# S3_ENDPOINT: Internal endpoint used by backend container (default: http://garage:3900)
# S3_BUCKET: S3 bucket name for quiz media (default: media)
# S3_REGION: S3 region (default: garage)
# S3_PUBLIC_URL: Public URL root used by browsers to stream media (default: https://${DOMAIN}/media)
S3_ENDPOINT=http://garage:3900
S3_BUCKET=media
S3_REGION=garage
S3_PUBLIC_URL=https://${DOMAIN}/media

# Cloudflare Zero Trust Tunnel (for docker-compose-rpi-CfZeroTrust.yml)
# Obtain this token when creating a Cloudflared tunnel in Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=


