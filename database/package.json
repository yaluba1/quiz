{
  "name": "@quiz/database",
  "version": "1.0.0",
  "description": "Relational persistence, Drizzle schema, migrations, and seed scripts for Open Quiz",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
